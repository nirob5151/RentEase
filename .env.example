# ====================================================================
# RentEase Environment Variables Configuration
# ====================================================================

# --------------------------------------------------------------------
# CLIENT-SIDE VARIABLES (Safe to expose to browser, prefixed with VITE_)
# Create a project at https://supabase.com and copy public credentials below:
# --------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --------------------------------------------------------------------
# SERVER-ONLY VARIABLES (NEVER expose to client browser, NO VITE_ prefix)
# Used by Vercel Serverless Functions / Supabase Edge Functions:
# - api/send-otp.js
# - api/verify-otp.js
# --------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
EMAIL_FROM=onboarding@resend.dev
